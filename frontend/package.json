{
  "name": "okko-erp-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "i18n": "node scripts/i18n/scan.mjs",
    "i18n:check": "node scripts/i18n/scan.mjs --check",
    "i18n:prune": "node scripts/i18n/scan.mjs --prune",
    "i18n:todo": "node scripts/i18n/scan.mjs --todo",
    "i18n:wrap": "node scripts/i18n/wrap.mjs && node scripts/i18n/wrap-ast.mjs",
    "i18n:keyize": "node scripts/i18n/keyize.mjs",
    "i18n:merge": "node scripts/i18n/merge.mjs scripts/i18n/translations",
    "i18n:rename": "node scripts/i18n/rename-key.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.312.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "tailwind-merge": "^2.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/three": "^0.185.3",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
