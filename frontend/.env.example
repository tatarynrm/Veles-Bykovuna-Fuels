# Скопіюйте у .env.production перед збіркою на сервері.
# NEXT_PUBLIC_* змінні вшиваються у бандл ПІД ЧАС `next build` —
# після зміни значення потрібна повторна збірка.

# Публічна адреса бекенда, як її бачить браузер користувача.
# Наприклад: https://erp.veles.ua/api-host або http://SERVER_IP:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
