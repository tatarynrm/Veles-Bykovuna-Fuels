# Скопіюйте цей файл у .env і заповніть реальними значеннями.
# Файл .env НЕ комітиться в git (див. .gitignore).

# Порт для локальної розробки. На сервері PM2 задає PORT=7001
# через ecosystem.config.js, і він має пріоритет над цим значенням.
PORT=3001

# Продакшен: кома-розділений список дозволених origin для CORS.
# Порожньо/відсутнє = дозволені всі (тільки для розробки!)
CORS_ORIGIN=

# OKKO ERP API (gw-online.okko.ua)
OKKO_API_KEY=your-okko-api-key
OKKO_LOGIN=your-okko-login
OKKO_PASSWORD=your-okko-password
OKKO_BASE_URL=https://gw-online.okko.ua:9443/api/erp

# Shell Mobility B2B (Card Transaction Data API)
# Авторизація: заголовок "Authorization: Basic base64(SHELL_API_KEY:SHELL_SECRET)"
# збирається в коді — достатньо задати ключ і секрет.
SHELL_API_KEY=your-shell-api-key
SHELL_SECRET=your-shell-secret
# Продакшн: https://api.shell.com  ·  Тест: https://api-test.shell.com/test
SHELL_BASE_URL=https://api.shell.com
# Реквізити платника (видає Shell). ColCoCode — код країни-емітента карт.
SHELL_PAYER_NUMBER=PL60039295
SHELL_COLCO_CODE=42
# Необовʼязково: готовий заголовок цілком (має пріоритет над key+secret)
# SHELL_BASIC_AUTH=Basic your-base64-credentials
# Суми Shell (EUR/PLN тощо) конвертуються у грн за курсом НБУ (кеш — доба).
# Ці змінні — резервний курс, якщо НБУ недоступний (UAH за 1 одиницю валюти):
# FX_EUR_UAH=45
# FX_PLN_UAH=11
# FX_USD_UAH=41

# Ruptela / fm-track телематика
RUPTELA_API_KEY=your-ruptela-api-key
RUPTELA_BASE_URL=https://api.fm-track.com

# Нова Пошта (відстеження + створення відправлень)
# Ключ беруть у кабінеті НП: Налаштування → Безпека → Ключі API.
NOVAPOSHTA_API_KEY=your-novaposhta-api-key
NOVAPOSHTA_BASE_URL=https://api.novaposhta.ua/v2.0/json/

# Авторизація дашборда
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=change-me
# Демо-входи (okko/shell/demo без пароля) — тільки для розробки
AUTH_DEMO_ENABLED=false
# Гостьовий вхід guest/guest (креденшили публічні, показані на сторінці входу).
# Роль GUEST — лише перегляд: ReadOnlyGuard блокує всі не-GET запити,
# тож гість не може створити поїздку в Ruptela. false — вимкнути гостьовий вхід.
AUTH_GUEST_ENABLED=true
