{
  // ───────────────────────────────────────────────────────────────────────────
  //  Налаштування фонових синхронізацій. Файл читається НА ЛЬОТУ: збережіть
  //  зміни — розклад переставиться сам, перезапускати бекенд не треба.
  //
  //  • Можна лишати коментарі (// та /* */).
  //  • Якщо у файлі помилка, бекенд далі працює з останніми справними значеннями
  //    і пише попередження в лог (видно й на сторінках синхронізації).
  //  • Пропущений ключ = значення за замовчуванням, тож зайве можна просто стерти.
  //  • `enabled` нижче закоментовані: поки вони закоментовані, вмикання/вимикання
  //    бере з backend/.env (OKKO_SYNC_ENABLED, SHELL_SYNC_ENABLED, GPS_SYNC_ENABLED).
  //    Розкоментуйте — і керувати ними можна просто звідси, файл має пріоритет.
  //  • Інший шлях до файлу: SYNC_CONFIG_FILE у backend/.env
  // ───────────────────────────────────────────────────────────────────────────

  // Транзакції паливних карток → Oracle, процедура P_API_TRUCK_PAY.save_transaction
  "fuel": {
    // Коли запускати, місцевий час сервера. Можна скільки завгодно: ["09:00", "15:00"]
    // Запускаються обидва вендори підряд: спочатку OKKO, потім Shell.
    "times": ["09:00", "15:00"],

    // Скільки останніх днів перечитувати щоразу. Якщо синхронізація довго стояла —
    // візьме глибше, щоб закрити пропуск. Повторне надсилання безпечне.
    "lookbackDays": 7,

    "okko": {
      // "enabled": true,
      // Звідки качати при повній закачці або коли в TZ_TRANS ще немає рядків бренду.
      // Зараз — з початку поточного року; на січень наступного року змініть рік вручну.
      "startDate": "2026-01-01"
    },
    "shell": {
      // "enabled": true,
      "startDate": "2026-01-01"
    }
  },

  // Статуси відправлень Нової Пошти → Oracle, процедура p_post.SetStatus
  "novaposhta": {
    "enabled": true,
    "everyHours": 3,
    // Вікно вибірки: ширше за крок, щоб пропущений тік сам надолужився
    "windowDays": 40
  },

  // Історія координат Ruptela → Oracle, процедура p_gps.AddGps
  "gps": {
    // "enabled": true,
    "everyMinutes": 1
  }
}
